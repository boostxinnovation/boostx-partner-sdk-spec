{
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 120,
	"semi": false,
	"singleQuote": true,
	"trailingComma": "all",
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"overrides": [
		{
			"files": "*.jsonc",
			"options": {
				"parser": "jsonc",
				"trailingComma": "none"
			}
		},
		{
			"files": "package.json",
			"options": {
				"useTabs": false
			}
		}
	]
}
